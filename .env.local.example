# ============================================================
# Required in Local, Vercel Preview, and Vercel Production.
# ============================================================

# Supabase Project Settings -> Data API.
# For new Supabase projects, paste the publishable key into the
# NEXT_PUBLIC_SUPABASE_ANON_KEY slot. Legacy anon JWTs also work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Supabase server-side key. For new Supabase projects, use sb_secret_*.
# Legacy service_role JWTs also work. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key

# WhatsApp token encryption: 64 hex chars = 32 bytes for AES-256-GCM.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta App Secret (Meta for Developers -> App Settings -> Basic).
META_APP_SECRET=your-meta-app-secret

# Canonical deployment URL. Set this separately in Vercel Preview and
# Production. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional cron hardening for /api/automations/cron and /api/flows/cron.
AUTOMATION_CRON_SECRET=
